{
  "name": "neural-math-lab",
  "private": true,
  "version": "1.0.0",
  "description": "Multimodal AI Math Tutor — Socratic teaching, OCR, dynamic grading, prerequisite engine",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:web": "vite",
    "dev:backend": "node server/proxy.js",
    "dev:ui": "vite",
    "dev:api": "node server/proxy.js",
    "dev:full": "concurrently \"npm:dev:api\" \"npm:dev:ui\"",
    "build:web": "vite build",
    "build": "vite build",
    "build:pages": "vite build --base=./",
    "start:api": "node server/proxy.js",
    "preview:web": "vite preview",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chart.js": "^4.4.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "katex": "^0.16.9",
    "mathjs": "^12.2.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.0.1",
    "vite": "^5.1.0"
  }
