# === Backend Proxy (required for secure key handling) ===
PROXY_PORT=8787
STRICT_MODE=true
# Comma-separated allowlist for web origins (example: https://USER.github.io,https://app.example.com)
CORS_ORIGIN=*

# === Azure OpenAI (server-side only; do NOT expose in browser) ===
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=your-azure-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# === Azure AI Search (RAG, server-side only) ===
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX=math-textbook

# === Ollama (server-side proxy target) ===
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=deepseek-r1:7b

# === Mathpix OCR (optional) ===
VITE_MATHPIX_APP_ID=your-mathpix-id
VITE_MATHPIX_APP_KEY=your-mathpix-key

# === Frontend API Routing (for split deploys) ===
# Leave empty for local dev with Vite proxy, or set to your hosted backend URL for GitHub Pages.
# Example: VITE_API_BASE_URL=https://math-tutor-api.onrender.com
VITE_API_BASE_URL=

# Optional: dev-only proxy target used by vite.config.js
VITE_DEV_API_TARGET=http://localhost:8787

# Optional: asset base path for custom build flows
# Example: /Math_tutor/
VITE_BASE_PATH=/

# === Student Name ===
VITE_STUDENT_NAME=Student

# === Optional local state encryption (frontend) ===
VITE_LOCAL_VAULT_KEY=change-me-for-hackathon
